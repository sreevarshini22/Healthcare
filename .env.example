# MediVault Environment Variables Configuration

# 1. Flask Application Security
FLASK_SECRET_KEY=generate-a-secure-random-secret-key-for-production-here
FLASK_DEBUG=1
FLASK_ENV=development
PORT=5000

# 2. MongoDB Database Configuration
# Local MongoDB: mongodb://localhost:27017/medivault_db
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/medivault_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/medivault_db
MONGODB_DATABASE=medivault_db

# 3. Private Isolated Document Storage
STORAGE_FOLDER=storage

# 4. AI Chatbot & Report Summarization (OpenAI / Google Gemini / Local Clinical NLP)
AI_PROVIDER=auto
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here
AI_MODEL=gpt-4o-mini

# 5. Telephony & AI Voice Agent (Twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567
VOICE_CALLBACK_BASE_URL=https://your-domain.com

# 6. Multi-Channel Email & SMS Notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=notifications@medivault-health.org

# 7. Background Reminder Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
